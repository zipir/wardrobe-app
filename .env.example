# Bu dosyayı .env adıyla kopyalayıp değerleri doldurun. .env depoya gönderilmez.
# EXPO_PUBLIC_ ile başlayan değerler uygulamanın içine gömülür; buraya yalnızca
# herkese açık olması sakıncasız değerler yazılır (Supabase URL ve anon key gibi).
# Yapay zeka API anahtarları ASLA buraya yazılmaz; yalnızca Supabase sunucu
# fonksiyonlarının gizli ayarlarında (secrets) tutulur.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_SENTRY_DSN=
